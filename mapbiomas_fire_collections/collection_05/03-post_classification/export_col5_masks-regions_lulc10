// FUNÇÃO: classes finais por bioma
function getMaskClasses(biome,region,year){
  var classes = CONFIG.classes[biome].slice();
  // regra regional
  if(CONFIG.region_rules[biome] && CONFIG.region_rules[biome][region]){
    classes = classes.concat(CONFIG.region_rules[biome][region]);}
  // regra anual
  if(CONFIG.year_rules[biome] && CONFIG.year_rules[biome][year]){
    classes = classes.concat(CONFIG.year_rules[biome][year]);}
  return classes;
}

// EXPORTAÇÃO
function exportImage(obj){
  var image = ee.Image(obj.id);
  var name = obj.id.split('/')[6];
  var split = name.split('-');
  var biome = split[0];
  var year = split[1];
  var region = split[2];

Map.addLayer(image, {min:0, max:1, palette:['red']}, 'burn BEFORE mask', false);

  // regra de ano LULC
  var yearAlternative = year === '2025' ? '2024' : year;
  // classes automáticas
  var mask_classes = getMaskClasses(biome,region,year);
  var mask = landcover
  .select(ee.String('classification_').cat(yearAlternative))
  .eq(mask_classes)
  .reduce('sum')
  .gte(1);

  // BUFFER ESPECIAL PANTANAL
  if(biome === 'PANTANAL'){
    var bufferPantanal = landcover
    .select(ee.String('classification_').cat(yearAlternative))
    .eq(CONFIG.pantanal_buffer_class)
    .selfMask()
    .focalMode({
      radius:100,
      kernelType:'square',
      units:'meters'
    })
    .gte(1)
    .clip(lakes_pantanal);
    mask = mask.blend(bufferPantanal);

  }

  // MÁSCARA PANTANAL
  var mask_pantanal = ee.Image(1).paint(mascara_pantanal,0);
  mask = mask.updateMask(mask_pantanal);
  // MÁSCARA ÁGUA ESTÁVEL
  var water_mask = water_stable.unmask().neq(1);
  // aplicar máscara
  var image_mask = image.updateMask(water_mask);
  Map.addLayer(image_mask, {min:0, max:1, palette:['black']}, 'burn AFTER water mask', false);  
  // MÁSCARA FINAL
  var final_mask = mask.neq(1);
  image_mask = image_mask.updateMask(final_mask);
  // REMOÇÃO PIXELS ISOLADOS
  var connections = image_mask.connectedPixelCount({
    maxSize:100,
    eightConnected:false
  });
  var filter_size = CONFIG.pixel_filter[biome] || CONFIG.pixel_filter.default;
  var solitary_pixels = connections.lte(filter_size);
  image_mask = image_mask
  .where(solitary_pixels,0)
  .selfMask()
  .reproject('EPSG:4326',null,30);
  Map.addLayer(image_mask, {min:0, max:1, palette:['pink']}, 'burn AFTER ALL masks', false);
  // QUALITY MOSAIC
  ee.Number.parse(year).int().evaluate(function(y){
    var qualityMosaic = collection_landsat
    .landsat_year(y,geometry)
    .qualityMosaic('nbr')
    .select('monthOfYear')
    .byte();
    var startDate = ee.Date.fromYMD(y,1,1);
    var endDate = ee.Date.fromYMD(y+1,1,1);
    var image_final = qualityMosaic
    .updateMask(image_mask)
    .set({
      source:'IPAM',
      pixel_unit:'month',
      name:name,
      year:y,
      region:region,
      biome:biome,
      system_time_start:startDate.millis(),
      system_time_end:endDate.millis()
    });

    Export.image.toAsset({
      image:image_final,
      description:name,
      assetId:collection_output + '/' + name,
      pyramidingPolicy:'mode',
      region:geometry,
      scale:30,
      maxPixels:1e13,
      overwrite: true
    });
  });
}

// FILTRO DE EXECUÇÃO
function runFilter(obj){
  var name = obj.id.split('/')[6];
  var split = name.split('-');
  var biome = split[0];
  var year = split[1];
  var region = split[2];

  if(RUN.biomes.length && RUN.biomes.indexOf(biome) === -1){return false;}
  if(RUN.regions.length && RUN.regions.indexOf(region) === -1){return false;}
  if(RUN.years.length && RUN.years.indexOf(year) === -1){return false;}

  return true;

}
ee.data.listAssets(collection)
.assets
.filter(runFilter)
.forEach(exportImage);
