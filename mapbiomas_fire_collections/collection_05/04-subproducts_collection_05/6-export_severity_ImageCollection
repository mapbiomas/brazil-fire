/**** dNBR MENSAL — 1985–2025 | área queimada | 30 m

MapBiomas Fogo — Coleção 5.1

Produto gerado:
- severity_dnbr_imgCol
- severity_class_imgCol

dNBR = NBR_post − NBR_pre

NBR_post:
  mínimo NBR do ano via NBR invertido + qualityMosaic

NBR_pre:
  valor do mês −2 em relação ao fogo
  fallback: último pixel válido nos 6 meses anteriores ao fogo

Observações:
• Saída contém apenas pixels queimados
• Série Landsat 5/7/8/9 harmonizada — Collection 2
• NBR invertido × -1 para otimizar reducers
• Fallback garante valor pre-fire quando não há observação no mês alvo

****/


// ===================== PARÂMETROS =====================

var YEAR0 = 1985;
var YEAR1 = 2025;

var OUT_ROOT = 'projects/mapbiomas-workspace/FOGO/COLLECTIONS/COL05/1_Subproducts';

var NAME_MONTHLY = 'mapbiomas_fire_collection5_monthly_burned_v1';
var mbBurnedMonthlyAsset = OUT_ROOT + '/' + NAME_MONTHLY;

var outFileName = 'mapbiomas_fire_collection5_severity_dnbr_imgCol';
var outFileNameClass = 'mapbiomas_fire_collection5_severity_class_imgCol';

var bandName = 'dNBR_';

var visClass = {
  min: 1,
  max: 6,
  palette: [
    '#00441b',
    '#7FFF00',
    '#FFFF00',
    '#FFA500',
    '#FF0000',
    '#8B0000'
  ]
};

// ===================== CLASSIFICAÇÃO =====================

function classifyDNBR(img, year) {
  img = ee.Image(img);
  var dnbr = img.toInt16();

  var classes = ee.Image(0)
    .where(dnbr.lt(0), 1)
    .where(dnbr.gte(0).and(dnbr.lte(269)), 2)
    .where(dnbr.gte(270).and(dnbr.lte(439)), 3)
    .where(dnbr.gte(440).and(dnbr.lte(659)), 4)
    .where(dnbr.gte(660).and(dnbr.lte(1350)), 5)
    .where(dnbr.gt(1350), 6)
    .updateMask(img.mask())
    .rename('classification')
    .toByte();

  return ee.Image(classes).copyProperties(img, img.propertyNames());
}
// ===================== BLOCKLIST =====================

var blockList_landsat = require(
  'users/geomapeamentoipam/MapBiomas__Fogo:00_Tools/module-blockList'
).landsat();


// ===================== FUNÇÕES BASE =====================
// remove bordas Landsat (~3 km)
function clipBoard_Landsat(img){
  return img.updateMask(
    ee.Image().paint(img.geometry().buffer(-3000)).eq(0)
  );
}


// ===================== CORREÇÕES LS8/9 =====================
function corrections_LS89_col2(img){

  // escala reflectância
  img = img.addBands(
    img.select('SR_B.*').multiply(0.0000275).add(-0.2),
    null, true
  );

  var qa = img.select('QA_PIXEL');
  var radsat = img.select('QA_RADSAT');

  // máscaras
  var cloud = qa.bitwiseAnd(1<<3).and(qa.bitwiseAnd(1<<9))
    .or(qa.bitwiseAnd(1<<4));

  var good = qa.bitwiseAnd(1<<6).or(qa.bitwiseAnd(1<<7));

  var sat = radsat.bitwiseAnd(127); // bits 0–6 juntos

  return img
    .updateMask(cloud.not())
    .updateMask(good)
    .updateMask(sat.eq(0))
    .select(
      ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'],
      ['blue','green','red','nir','swir1','swir2']
    )
    .float();
}


// ===================== CORREÇÕES LS5/7 =====================
function corrections_LS57_col2(img){

  // escala reflectância
  img = img.addBands(
    img.select('SR_B.*').multiply(0.0000275).add(-0.2),
    null, true
  );

  var qa = img.select('QA_PIXEL');

  // máscara básica (nuvem + sombra)
  var mask = qa.bitwiseAnd(1<<3).eq(0)
    .and(qa.bitwiseAnd(1<<5).eq(0));

  return img
    .updateMask(mask)
    .select(
      ['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'],
      ['blue','green','red','nir','swir1','swir2']
    )
    .float();
}

// ===================== NBR INVERTIDO =====================
// NBR invertido (facilita reducers: menor = pós-fogo)
function addBand_NBRinv(img){

  var nbr = img.normalizedDifference(['nir','swir2']);

  return img.addBands(
    nbr.add(1)
       .multiply(-1000)
       .int16()
       .rename('nbr')
  );
}


// ===================== PREP COLLECTION =====================
// prepara coleção: correção + NBR + filtro blocklist
function prepColNBR(address, region, start, end, corrFn){

  return ee.ImageCollection(address)
    .filterDate(start, end)
    .filterBounds(region)
    .filter(ee.Filter.inList('system:index', blockList_landsat).not())
    .map(function(img){
      return addBand_NBRinv(
        corrFn(clipBoard_Landsat(img))
      ).select('nbr');
    });
}

// ===================== MERGE =====================
// merge de múltiplas coleções
function mergeCollections(cols){

  return ee.ImageCollection(
    ee.List(cols).iterate(function(c, acc){
      return ee.ImageCollection(acc).merge(c);
    }, ee.ImageCollection([]))
  );
}


// ===================== CONSTELAÇÕES =====================
// datasets Landsat
var datasets = {
  LC08: 'LANDSAT/LC08/C02/T1_L2',
  LC09: 'LANDSAT/LC09/C02/T1_L2',
  LT05: 'LANDSAT/LT05/C02/T1_L2',
  LE07: 'LANDSAT/LE07/C02/T1_L2'
};

// seleção por ano
function getConstellationsForYearJS(y){

  if (y <= 1998) return ['LT05'];
  if (y <= 2012) return ['LT05','LE07'];
  if (y <= 2021) return ['LE07','LC08'];

  return ['LC08','LC09'];
}

// função de correção por sensor
function corrFnForSat(s){

  return (s === 'LC08' || s === 'LC09')
    ? corrections_LS89_col2
    : corrections_LS57_col2;
}

// ===================== POST ANUAL =====================

// menor NBR do ano (via NBR invertido + qualityMosaic)
function buildAnnualPost(geom, start, end, consts){

  var col = mergeCollections(
    consts.map(function(s){
      return prepColNBR(
        datasets[s], geom, start, end, corrFnForSat(s)
      );
    })
  );

  return col.qualityMosaic('nbr')
    .select('nbr')
    .rename('nbr_post');
}

// ===================== PRE (MÊS / FALLBACK) =====================
//maxNBR na janela 2 meses antes do fogo
function buildPre_maxNBR(geom, start, end, consts, mask){
  var col = mergeCollections(
    consts.map(function(s){
      return prepColNBR(
        datasets[s], geom, start, end, corrFnForSat(s)
      ).map(function(img){
        return img.updateMask(mask);
      });
    })
  );

  return col
    .qualityMosaic('nbr')   // 🔥 max NBR real
    .select('nbr')
    .rename('nbr_pre_max');
}
// último pixel válido no período
function buildPre_lastValid(geom, start, end, consts, mask){

  var col = mergeCollections(
    consts.map(function(s){
      return prepColNBR(
        datasets[s], geom, start, end, corrFnForSat(s)
      ).map(function(img){
        return img.updateMask(mask);
      });
    })
  );

  return col
    .sort('system:time_start', false)
    .mosaic()
    .rename('nbr_pre_fb');
}

// ===================== DNBR MENSAL =====================
function dnbr_monthly_MaxNBRminus2m_fallback(y, geom){

  var burnedMonth = ee.Image(mbBurnedMonthlyAsset)
    .select('burned_monthly_' + y)
    .rename('burned_month')
    .clip(region);

  var inBurn = burnedMonth.gt(0).selfMask();

  var startYear = ee.Date.fromYMD(y,1,1);
  var endYear   = startYear.advance(1,'year');

  var consts = getConstellationsForYearJS(y);

  var nbrPost = buildAnnualPost(
    geom, startYear, endYear, consts
  );

  // imagem acumuladora
  var out = ee.Image(0)
    .rename('dNBR_monthly')
    .updateMask(ee.Image(0));

  for (var m = 1; m <= 12; m++){

    var fireDate = ee.Date.fromYMD(y, m, 1);
    var monthMask = burnedMonth.eq(m).selfMask();

    // PRE (-2 meses) → MAX NBR
    var preMax = buildPre_maxNBR(
      geom,
      fireDate.advance(-2,'month'),
      fireDate.advance(-1,'month'),
      consts,
      monthMask
    );
    
    // FALLBACK (6 meses antes) → último válido
    var preFB = buildPre_lastValid(
      geom,
      fireDate.advance(-6,'month'),
      fireDate,
      consts,
      monthMask
    );
    
    // Combinação correta
    var pre = preMax.unmask(preFB);

    out = out.blend(
      nbrPost
        .subtract(pre)
        .rename('dNBR_monthly')
        .updateMask(monthMask)
    );
  }

  return out
    .updateMask(inBurn)
    .int16()
    .set({
      year: y,
      'system:index': String(y)
    });
}

// ===================== EXPORT =====================
for (var y = YEAR0; y <= YEAR1; y++){

  var img = dnbr_monthly_MaxNBRminus2m_fallback(y, region)
    .rename(bandName + y) // dNBR_1985, dNBR_1986...
    .set({year: y});


  Export.image.toAsset({

    image: img,
    description: 'EXPORT_' + outFileName + '_' + y,
    assetId: OUT_ROOT + '/' + outFileName + '/' + y,
    region: region,
    scale: 30,
    maxPixels: 1e13,
    pyramidingPolicy: {'.default':'mean'},
    overwrite: true

  });

}

// ===================== EXPORT CLASSIFIED =====================
for (var y = YEAR0; y <= YEAR1; y++) {

  var assetIn = OUT_ROOT + '/' + outFileName + '/' + y;
  var dnbr = ee.Image(assetIn).rename('dNBR_' + y);

  var classified = ee.Image(classifyDNBR(dnbr, y)).set({
    year: y,
    'system:index': String(y)
  });

  Map.addLayer(classified, visClass, 'classification_' + y, false);

  Export.image.toAsset({
    image: classified.rename('classification_' + y),
    description: 'EXPORT_' + outFileNameClass + '_' + y,
    assetId: OUT_ROOT + '/' + outFileNameClass + '/' + y,
    region: region,
    scale: 30,
    maxPixels: 1e13,
    pyramidingPolicy: {'.default': 'mode'},
    overwrite: true
  });
}
