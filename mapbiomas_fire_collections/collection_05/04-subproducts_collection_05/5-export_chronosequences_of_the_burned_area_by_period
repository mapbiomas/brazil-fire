// Annual burned area image collection
var assetFire = 'projects/mapbiomas-workspace/FOGO/COLLECTIONS/COL05/1_Subproducts/mapbiomas_fire_collection5_annual_burned_v1';
// Output file names
var outFileName_taf = 'mapbiomas_fire_collection5_time_after_fire_v1';
var outFileName_tbf = 'mapbiomas_fire_collection5_time_before_fire_v1';
var outFileName_isf = 'mapbiomas_fire_collection5_interval_since_fire_v1';
var outFileName_isf_class = 'mapbiomas_fire_collection5_interval_since_fire_class_v1';
var outFileName_ylf = 'mapbiomas_fire_collection5_year_last_fire_v1';


// Output directory of assets
var assetOutput = 'projects/mapbiomas-workspace/FOGO/COLLECTIONS/COL05/1_Subproducts'

var initialBand = 'classification_1985';
var finalBand = 'classification_2025';
// Export.image.toAsset() params
var scale = 30;

// Converting monthly burned coverage to time after fire
var scars = ee.Image(assetFire).gte(1);
Map.addLayer(scars, {}, 'Burned Areas', false);
var scars2026 = scars.addBands(scars.select('burned_area_2025').rename('burned_area_2026'));
// Iteration over years to calculate time after fire
var years = scars.bandNames().map(function(bandname) {
  return ee.Number.parse(ee.String(bandname).slice(-4));
});

// Function to calculate time after fire
function timeAfterFire(current, previous) {
  var year = ee.Number(current).int();
  var yearPost = year.add(1);

  var sliceIndex = years.indexOf(current);
  sliceIndex = ee.Number(sliceIndex).add(1);
  var sliceList = years.slice(0, sliceIndex, 1);

  var alreadyBurned = sliceList.map(function(y) {
    return scars.select([ee.String('burned_area_').cat(ee.Number(y).int())])
      .rename('classification');
  });
  alreadyBurned = ee.ImageCollection(alreadyBurned).mosaic().byte();
  alreadyBurned = ee.Image(1).updateMask(alreadyBurned).byte();

  var burnedThisYear = ee.Image(1).updateMask(scars.select([ee.String('burned_area_').cat(year)]))
    .byte();

  var newImage = ee.Image(previous)
    .select(ee.String('classification_').cat(year))
    .add(alreadyBurned).byte();

  newImage = newImage.blend(burnedThisYear);

  return ee.Image(previous)
    .addBands(
      newImage.rename(ee.String('classification_').cat(yearPost))
    );
}

var first = ee.Image(0).mask(0).rename(initialBand);
var timeAfterFireImage = ee.Image(years.iterate(timeAfterFire, first));
// preenche áreas queimadas inéditas com 0, agora compatível com 2026
timeAfterFireImage = scars2026.multiply(0)
  .blend(timeAfterFireImage)
  .rename(timeAfterFireImage.bandNames());
print('timeAfterFireImage', timeAfterFireImage);

// Iteration over years to calculate time before fire
years = years.reverse();

function timeBeforeFire(current, previous) {
  var year = ee.Number(current).int();
  var yearPost = year.subtract(1);

  var sliceIndex = years.indexOf(current);
  sliceIndex = ee.Number(sliceIndex).add(1);
  var sliceList = years.slice(0, sliceIndex, 1);

  var alreadyBurned = sliceList.map(function(y) {
    return scars.select([ee.String('burned_area_').cat(ee.Number(y).int())])
      .rename('classification');
  });
  alreadyBurned = ee.ImageCollection(alreadyBurned).mosaic().byte();
  alreadyBurned = ee.Image(1).updateMask(alreadyBurned).byte();

  var burnedThisYear = ee.Image(1).updateMask(scars.select([ee.String('burned_area_').cat(year)]))
    .byte();

  var newImage = ee.Image(previous)
    .select(ee.String('classification_').cat(year))
    .add(alreadyBurned).byte();

  newImage = newImage.blend(burnedThisYear);

  return ee.Image(previous)
    .addBands(
      newImage.rename(ee.String('classification_').cat(yearPost))
    );
}

var first = ee.Image(0).mask(0).rename(finalBand);
var timeBeforeFireImage = years.iterate(timeBeforeFire, first);
timeBeforeFireImage = ee.Image(timeBeforeFireImage);
timeBeforeFireImage = timeBeforeFireImage
  .select(timeBeforeFireImage.bandNames().reverse()).slice(1);
// preenche áreas queimadas inéditas com 0
timeBeforeFireImage = scars.multiply(0)
  .blend(timeBeforeFireImage)
  .rename(timeBeforeFireImage.bandNames());

print('timeBeforeFireImage', timeBeforeFireImage);

// Visualization
var palette = [
  "FFFFFF", "800000", "850708", "8B0E0F", "901417", "961B1E",
  "9B2226", "9F2222", "A3211E", "A6211A", "AA2016", "AE2012",
  "B42E0F", "B93C0C", "BF4B08", "C45905", "CA6702", "BF7C27",
  "B4924D", "AAA772", "9FBD98", "94D2BD", "78C5B5", "5DB9AD",
  "41ACA6", "26A09E", "0A9460", "0876AB", "0658C0", "043BD5",
  "021DEA", "0000FF", "0000E6", "0000CC", "0000B3", "000080"
];


var year_vis = 2010;
var visParams = {
  bands: ['classification_' + year_vis],
  min: 0,
  max: 41,
  palette: palette
};

var visParams_2 = {
  bands: ['classification_' + year_vis],
  min: 1985,
  max: 2025,
  palette: palette
};

Map.addLayer(timeAfterFireImage, visParams, 'Time After Fire');
Map.addLayer(timeBeforeFireImage, visParams, 'Time Before Fire', false);


// time-after-fire';
// Exporting images to Asset
Export.image.toAsset({
  image: timeAfterFireImage.uint8(),
  description: outFileName_taf,
  assetId: assetOutput + '/' + outFileName_taf,
  pyramidingPolicy: 'mode',
  region: scars.geometry(),
  scale: 30,
  maxPixels: 1e13,
  overwrite: true
});
// time-before-fire
Export.image.toAsset({
  image: timeBeforeFireImage.uint8(),
  description: outFileName_tbf,
  assetId: assetOutput + '/' + outFileName_tbf,
  pyramidingPolicy: 'mode',
  region: scars.geometry(),
  scale: 30,
  maxPixels: 1e13,
  overwrite: true
});

//-- interval-since-fire

var intervalBands = timeAfterFireImage
  .bandNames()
  .removeAll(['classification_2026']);

var intervalSinceFireImage = timeAfterFireImage
  .select(intervalBands)
  .updateMask(scars)
  .uint8();

print('intervalSinceFireImage sem classification_2026', intervalSinceFireImage);
print('Bandas ISF', intervalSinceFireImage.bandNames());

Map.addLayer(intervalSinceFireImage, visParams, 'interval Since Fire');

Export.image.toAsset({
  image: intervalSinceFireImage,
  description: outFileName_isf,
  assetId: assetOutput + '/' + outFileName_isf,
  pyramidingPolicy: 'mode',
  region: scars.geometry(),
  scale: 30,
  maxPixels: 1e13,
  overwrite: true
});

