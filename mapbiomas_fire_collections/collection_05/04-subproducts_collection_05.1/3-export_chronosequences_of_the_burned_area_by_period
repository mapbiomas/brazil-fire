/** Gera cronossequências de fogo — MapBiomas Fogo Coleção 5.1 */

// -----------------------------------------------------------------------------
// Configuração
// -----------------------------------------------------------------------------

var assetFire = 'projects/mapbiomas-workspace/FOGO/COLLECTIONS/COL05/2_Subproducts_col51/mapbiomas_fire_collection51_annual_burned_v1';

var assetOutput = 'projects/mapbiomas-workspace/FOGO/COLLECTIONS/COL05/2_Subproducts_col51';

var scale = 30;
var startYear = 1985;
var endYear = 2025;
var nextYear = endYear + 1;

var outTimeAfterFire = 'mapbiomas_fire_collection51_time_after_fire_v1';
var outTimeBeforeFire = 'mapbiomas_fire_collection51_time_before_fire_v1';
var outIntervalSinceFire = 'mapbiomas_fire_collection51_interval_since_fire_v1';
var outIntervalSinceFireClass = 'mapbiomas_fire_collection51_interval_since_fire_class_v1';
var outYearLastFire = 'mapbiomas_fire_collection51_year_last_fire_v1';

var initialBand = 'classification_' + startYear;
var finalBand = 'classification_' + endYear;
var nextBand = 'classification_' + nextYear;

var years = ee.List.sequence(startYear, endYear);


// -----------------------------------------------------------------------------
// Áreas queimadas
// -----------------------------------------------------------------------------

var scars = ee.Image(assetFire).gte(1);

var scarsNextYear = scars.addBands(
  scars
    .select('burned_area_' + endYear)
    .rename('burned_area_' + nextYear)
);

Map.addLayer(scars, {}, 'Burned Areas', false);


// -----------------------------------------------------------------------------
// Tempo após o fogo
// -----------------------------------------------------------------------------

function timeAfterFire(current, previous) {

  var year = ee.Number(current).int();
  var yearPost = year.add(1);

  var sliceIndex = years.indexOf(current).add(1);
  var sliceList = years.slice(0, sliceIndex);

  var alreadyBurned = sliceList.map(function(y) {
    return scars
      .select([
        ee.String('burned_area_')
          .cat(ee.Number(y).int())
      ])
      .rename('classification');
  });

  alreadyBurned = ee.ImageCollection(alreadyBurned)
    .mosaic()
    .byte();

  alreadyBurned = ee.Image(1)
    .updateMask(alreadyBurned)
    .byte();

  var burnedThisYear = ee.Image(1)
    .updateMask(
      scars.select([
        ee.String('burned_area_').cat(year)
      ])
    )
    .byte();

  var newImage = ee.Image(previous)
    .select(
      ee.String('classification_').cat(year)
    )
    .add(alreadyBurned)
    .byte();

  newImage = newImage.blend(burnedThisYear);

  return ee.Image(previous).addBands(
    newImage.rename(
      ee.String('classification_').cat(yearPost)
    )
  );
}


var first = ee.Image(0)
  .mask(0)
  .rename(initialBand);

var timeAfterFireImage = ee.Image(
  years.iterate(timeAfterFire, first)
);

// Preenche áreas sem valor com zero.
timeAfterFireImage = scarsNextYear
  .multiply(0)
  .blend(timeAfterFireImage)
  .rename(timeAfterFireImage.bandNames());

print('timeAfterFireImage', timeAfterFireImage);


// -----------------------------------------------------------------------------
// Tempo antes do fogo
// -----------------------------------------------------------------------------

var yearsReverse = years.reverse();

function timeBeforeFire(current, previous) {

  var year = ee.Number(current).int();
  var yearPost = year.subtract(1);

  var sliceIndex = yearsReverse.indexOf(current).add(1);
  var sliceList = yearsReverse.slice(0, sliceIndex);

  var alreadyBurned = sliceList.map(function(y) {
    return scars
      .select([
        ee.String('burned_area_')
          .cat(ee.Number(y).int())
      ])
      .rename('classification');
  });

  alreadyBurned = ee.ImageCollection(alreadyBurned)
    .mosaic()
    .byte();

  alreadyBurned = ee.Image(1)
    .updateMask(alreadyBurned)
    .byte();

  var burnedThisYear = ee.Image(1)
    .updateMask(
      scars.select([
        ee.String('burned_area_').cat(year)
      ])
    )
    .byte();

  var newImage = ee.Image(previous)
    .select(
      ee.String('classification_').cat(year)
    )
    .add(alreadyBurned)
    .byte();

  newImage = newImage.blend(burnedThisYear);

  return ee.Image(previous).addBands(
    newImage.rename(
      ee.String('classification_').cat(yearPost)
    )
  );
}


first = ee.Image(0)
  .mask(0)
  .rename(finalBand);

var timeBeforeFireImage = ee.Image(
  yearsReverse.iterate(timeBeforeFire, first)
);

// Ordena e remove a banda anterior ao início da série.
var timeBeforeBands = timeBeforeFireImage
  .bandNames()
  .reverse()
  .slice(1);

timeBeforeFireImage = timeBeforeFireImage
  .select(timeBeforeBands);

// Preenche áreas sem valor com zero.
timeBeforeFireImage = scars
  .multiply(0)
  .blend(timeBeforeFireImage)
  .rename(timeBeforeFireImage.bandNames());

print('timeBeforeFireImage', timeBeforeFireImage);


// -----------------------------------------------------------------------------
// Intervalo desde o fogo
// -----------------------------------------------------------------------------

var intervalBands = timeAfterFireImage
  .bandNames()
  .remove(nextBand);

var intervalSinceFireImage = timeAfterFireImage
  .select(intervalBands)
  .updateMask(scars)
  .uint8();

print('intervalSinceFireImage', intervalSinceFireImage);
print('intervalSinceFire bands', intervalSinceFireImage.bandNames());


// -----------------------------------------------------------------------------
// Ano do último fogo
// -----------------------------------------------------------------------------

var yearLastFire = ee.Image(
  timeAfterFireImage
    .bandNames()
    .sort()
    .iterate(function(current, previous) {

      var bandName = ee.String(current);
      var year = ee.Number.parse(
        bandName.slice(-4)
      );

      var image = ee.Image.constant(year)
        .rename(bandName)
        .subtract(
          timeAfterFireImage
            .select(bandName)
            .selfMask()
        );

      return ee.Image(previous)
        .addBands(image);

    }, ee.Image().select())
)
.reproject('EPSG:4326', null, scale);

print('yearLastFire', yearLastFire);


// -----------------------------------------------------------------------------
// Visualização
// -----------------------------------------------------------------------------

var palette = [
  'FFFFFF', '800000', '850708', '8B0E0F', '901417', '961B1E',
  '9B2226', '9F2222', 'A3211E', 'A6211A', 'AA2016', 'AE2012',
  'B42E0F', 'B93C0C', 'BF4B08', 'C45905', 'CA6702', 'BF7C27',
  'B4924D', 'AAA772', '9FBD98', '94D2BD', '78C5B5', '5DB9AD',
  '41ACA6', '26A09E', '0A9460', '0876AB', '0658C0', '043BD5',
  '021DEA', '0000FF', '0000E6', '0000CC', '0000B3', '000080'
];

var yearVis = 2010;

var visTime = {
  bands: ['classification_' + yearVis],
  min: 0,
  max: endYear - startYear + 1,
  palette: palette
};

var visYear = {
  bands: ['classification_' + yearVis],
  min: startYear,
  max: endYear,
  palette: palette
};

Map.addLayer(
  timeAfterFireImage,
  visTime,
  'Time After Fire'
);

Map.addLayer(
  timeBeforeFireImage,
  visTime,
  'Time Before Fire',
  false
);

Map.addLayer(
  intervalSinceFireImage,
  visTime,
  'Interval Since Fire'
);

Map.addLayer(
  yearLastFire,
  visYear,
  'Year Last Fire'
);


// -----------------------------------------------------------------------------
// Exportação
// -----------------------------------------------------------------------------

function exportAsset(image, name) {

  Export.image.toAsset({
    image: image,
    description: name,
    assetId: assetOutput + '/' + name,
    pyramidingPolicy: {
      '.default': 'mode'
    },
    region: scars.geometry(),
    scale: scale,
    maxPixels: 1e13,
    overwrite: true
  });
}


exportAsset(
  timeAfterFireImage.uint8(),
  outTimeAfterFire
);

exportAsset(
  timeBeforeFireImage.uint8(),
  outTimeBeforeFire
);

exportAsset(
  intervalSinceFireImage.uint8(),
  outIntervalSinceFire
);

exportAsset(
  yearLastFire.uint16(),
  outYearLastFire
);

