/**
 * @Description
 * MapBiomas Fire Collection 5.1
 *
 * Classifies annual burned scars by size range based on the estimated
 * burned-scar area in hectares. Each annual band is classified into
 * eight size classes ranging from <10 ha to >=100,000 ha.
 *
 * Period: 1985–2025
 * Spatial resolution: 30 m
 * Output: Google Earth Engine Asset
 *
 * v1: https://code.earthengine.google.com/0f292403e2f7d7043603c970fe37d6ea
 */

print('Burned Area Analysis by Size Range');

var OUT_ROOT = 'projects/mapbiomas-workspace/FOGO/COLLECTIONS/COL05/2_Subproducts_col51',
    inputName = 'mapbiomas_fire_collection51_annual_burned_area_ha_v1',
    outFileName = 'mapbiomas_fire_collection51_annual_burned_scar_size_range_v1',
    scale = 30;

// Load annual burned-scar area
var scar_size = ee.Image(OUT_ROOT + '/' + inputName);

print('Burned area size:', scar_size);
Map.addLayer(scar_size.slice(-1), {min: 0, max: 1000}, 'Burned Area Size (ha)', false);

// Classify burned scars into size ranges
var scar_size_ranges = scar_size.multiply(0)
  .where(scar_size.gt(0).and(scar_size.lt(10)), 1)
  .where(scar_size.gte(10), 2)
  .where(scar_size.gte(250), 3)
  .where(scar_size.gte(500), 4)
  .where(scar_size.gte(5000), 5)
  .where(scar_size.gte(10000), 6)
  .where(scar_size.gte(50000), 7)
  .where(scar_size.gte(100000), 8);

// Size-class palette
var palette = [
  '#d0ae35', '#c68e2f', '#b96d2b', '#ac4b28',
  '#933328', '#72251d', '#4e180f', '#240d00'
];

Map.addLayer(
  scar_size_ranges.slice(-1),
  {min: 1, max: 8, palette: palette},
  'Burned Area Size Ranges'
);

// Export classified size ranges
Export.image.toAsset({
  image: scar_size_ranges,
  description: outFileName,
  assetId: OUT_ROOT + '/' + outFileName,
  pyramidingPolicy: 'mode',
  region: scar_size.geometry(),
  scale: scale,
  maxPixels: 1e13
});

// Size-range labels in hectares
var labels_ha = [
  [1, '< 10 ha'],
  [2, '10 - 250 ha'],
  [3, '250 - 500 ha'],
  [4, '500 - 5,000 ha'],
  [5, '5,000 - 10,000 ha'],
  [6, '10,000 - 50,000 ha'],
  [7, '50,000 - 100,000 ha'],
  [8, '>= 100,000 ha']
];

// Build legend
var legendPanel = labels_ha.map(function(item, i) {
  return ui.Panel([
    ui.Label('O', {backgroundColor: palette[i], margin: '1px'}),
    ui.Label(item[0] + ': ' + item[1], {fontSize: 10, margin: '1px'})
  ], ui.Panel.Layout.Flow('horizontal'), {margin: '1px'});
});

var legend = ui.Panel([
  ui.Panel(legendPanel, ui.Panel.Layout.Flow('vertical'),
    {margin: '1px', stretch: 'both', border: '0.5px solid red'})
    .insert(0, ui.Label('LEGEND'))
], ui.Panel.Layout.Flow('vertical'), {margin: '1px', position: 'bottom-left'});

Map.add(legend);
