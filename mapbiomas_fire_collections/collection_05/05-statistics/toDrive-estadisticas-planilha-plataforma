// Define as colunas básicas que SEMPRE estarão presentes, e na ordem desejada
var BASE_OUTPUT_COLUMNS = ['Área km²', 'Área ha', 'Ano', 'Coleção', 'Subproduto'];

// Funções auxiliares para obter os objetos de configuração pelo ID
var getDatasetConfigById = function(id) {
    for (var i = 0; i < FIRE_DATASETS.length; i++) {
        if (FIRE_DATASETS[i].id === id) {
            return FIRE_DATASETS[i];
        }
    }
    return null;
};
var getSpatialUnitConfigById = function(id) {
    for (var i = 0; i < SPATIAL_UNITS.length; i++) {
        if (SPATIAL_UNITS[i].id === id) {
            return SPATIAL_UNITS[i];
        }
    }
    return null;
};

/**
 * Inicia uma tarefa de exportação para uma combinação específica de dataset e unidade espacial.
 */
var startExportTask = function(dataset_obj, s_unit_obj, message_label) {
    message_label.setValue('Iniciando exportação: ' + dataset_obj.name + ' x ' + s_unit_obj.name + '...');
    message_label.style().set('color', 'blue');

    var mapbiomas_image = dataset_obj.image;
    var territory_image = s_unit_obj.image_generator();

    mapbiomas_image.bandNames().evaluate(function(bandnames) {
        var all_areas_for_export = ee.List(bandnames).map(function (bandname) {
            var image_to_process = mapbiomas_image.select([bandname]);
            var year = getYearFromBandnameUniversal(bandname);

            var areas = calculateArea(image_to_process, territory_image, dataset_obj, s_unit_obj, year, global_geometry);
            return areas;
        });

        all_areas_for_export = ee.FeatureCollection(all_areas_for_export).flatten();

        var final_folder_path = driverFolder + '/' + s_unit_obj.name;
        var final_file_name_prefix = 'export_' + dataset_obj.name + '_' + s_unit_obj.name;

        // --- COMPOSIÇÃO DINÂMICA DA LISTA 'SELECTORS' ---
        var selectors = ee.List(BASE_OUTPUT_COLUMNS)
            .cat(ee.List(dataset_obj.expected_output_columns))
            .cat(ee.List(s_unit_obj.expected_output_columns));

        selectors.evaluate(function(selectorsJsArray){

          Export.table.toDrive({
              collection: all_areas_for_export,
              description: final_file_name_prefix,
              folder: final_folder_path,
              fileNamePrefix: final_file_name_prefix,
              fileFormat: 'CSV',
              selectors: selectorsJsArray
          });

          message_label.setValue('Tarefa "' + final_file_name_prefix + '" iniciada. Verifique a aba Tasks.');
          message_label.style().set('color', 'green');
       });

    }, function(error) {
        message_label.setValue('Erro na exportação de ' + dataset_obj.name + ' x ' + s_unit_obj.name + ': ' + error);
        message_label.style().set('color', 'red');
        print('Erro na evaluate de bandnames para ' + dataset_obj.name + ' x ' + s_unit_obj.name + ':', error);
    });
};


