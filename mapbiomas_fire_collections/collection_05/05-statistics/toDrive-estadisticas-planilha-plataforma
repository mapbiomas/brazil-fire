// --- 6. FUNÇÃO PRINCIPAL DE CÁLCULO DE ÁREA ---

var calculateArea = function (image, territory_image, dataset_config, spatial_unit_config, year, geometry) {

    var reducer = ee.Reducer.sum().group(1, 'class').group(1, 'territory');

    var territotiesData = pixelArea.addBands(territory_image.rename('territory')).addBands(image.rename('class'))
        .reduceRegion({
            reducer: reducer,
            geometry: geometry,
            scale: scale,
            maxPixels: 1e12
        });

    territotiesData = ee.List(territotiesData.get('groups'));

    var areas = territotiesData.map(
        function (obj) {
            obj = ee.Dictionary(obj);

            var territory_int = obj.getNumber('territory').int();
            var classesAndAreas = ee.List(obj.get('groups'));

            var tableRows = classesAndAreas.map(
                function (classAndArea) {
                    classAndArea = ee.Dictionary(classAndArea);

                    var classId = classAndArea.getNumber('class');

                    var area_km2 = classAndArea.get('sum');
                    var area_ha = ee.Number(area_km2).multiply(100);

                    // 1. Propriedades base da linha (comuns a todos)
                    var base_properties = ee.Dictionary({
                        'Área ha': area_ha,
                        'Ano': year,
                    });

                    // 2. Propriedades do dado do pixel (lenda principal, LULC ou não-LULC)
                    var pixel_data_props = dataset_config.decodeStrategy(classId, dataset_config.legend_column_name);

                    // 3. Propriedades do recorte espacial
                    var spatial_props = spatial_unit_config.getProperties(territory_int);

                    // 4. Combina todas as propriedades em um único dicionário final.
                    var final_properties = base_properties
                        .combine(pixel_data_props)
                        .combine(spatial_props);

                    return ee.Feature(null, final_properties);
                }
            );
            return ee.FeatureCollection(ee.List(tableRows));
        }
    );
    return ee.FeatureCollection(areas).flatten();
};


